import java.util.PriorityQueue;

class Solution {
    public int[] assignTasks(int[] servers, int[] tasks) {
        int m = tasks.length;
        int n = servers.length;
        int[] ans = new int[m];
        
        PriorityQueue<int[]> idle = new PriorityQueue<>((a, b) -> {
            if (a[0] != b[0]) return Integer.compare(a[0], b[0]);
            return Integer.compare(a[1], b[1]);
        });
        
        PriorityQueue<int[]> busy = new PriorityQueue<>((a, b) -> {
            if (a[0] != b[0]) return Integer.compare(a[0], b[0]);
            if (a[1] != b[1]) return Integer.compare(a[1], b[1]);
            return Integer.compare(a[2], b[2]);
        });
        
        for (int i = 0; i < n; i++) {
            idle.offer(new int[]{servers[i], i}); // {weight, index}
        }
        
        int currentTime = 0;
        for (int j = 0; j < m; j++) {
            currentTime = Math.max(currentTime, j);
            
            while (!busy.isEmpty() && busy.peek()[0] <= currentTime) {
                int[] freeServer = busy.poll();
                idle.offer(new int[]{freeServer[1], freeServer[2]}); // {weight, index}
            }
            
            if (idle.isEmpty()) {
                currentTime = busy.peek()[0];
                while (!busy.isEmpty() && busy.peek()[0] <= currentTime) {
                    int[] freeServer = busy.poll();
                    idle.offer(new int[]{freeServer[1], freeServer[2]});
                }
            }
            
            int[] bestServer = idle.poll();
            int serverIdx = bestServer[1];
            ans[j] = serverIdx;
            
         
            busy.offer(new int[]{currentTime + tasks[j], bestServer[0], serverIdx});
        }
        
        return ans;
    }
}
