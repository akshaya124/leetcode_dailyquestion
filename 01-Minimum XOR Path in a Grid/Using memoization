class Solution {
    public int helper(int[][] grid, int i, int j,int dp[][]){
        if(i<0 || j<0){
            return -1;
        }
        if(i == 0  && j == 0){
            return dp[i][j] = grid[0][0];
        }
        if(dp[i][j] != -1){
            return dp[i][j];
        }
        int up = (helper(grid,i-1,j,dp) == -1)?-1:grid[i][j] ^ helper(grid,i-1,j,dp);
        int left = (helper(grid,i,j-1,dp) == -1)?-1:grid[i][j] ^ helper(grid,i,j-1,dp);
        if(up == -1) return left;
        if(left == -1) return up;
        return dp[i][j] = Math.min(up,left);
    }
    public int minCost(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        int dp[][] = new int[n][m];
        for(int row[]:dp){
            Arrays.fill(row,-1);
        }
        return helper(grid,n-1,m-1,dp);
    }
}
