import java.util.*;

public class Solution {
    public List<Integer> busiestServers(int k, int[] arrival, int[] load) {
        int[] count = new int[k];
        
        PriorityQueue<int[]> busy = new PriorityQueue<>((a, b) -> Integer.compare(a[0], b[0]));
        
        TreeSet<Integer> available = new TreeSet<>();
        for (int i = 0; i < k; i++) {
            available.add(i);
        }
        
        int maxRequests = 0;
        
        for (int i = 0; i < arrival.length; i++) {
            int arrivalTime = arrival[i];
            int currentLoad = load[i];
            
          
            while (!busy.isEmpty() && busy.peek()[0] <= arrivalTime) {
                int[] freed = busy.poll();
                available.add(freed[1]);
            }
            
            if (available.isEmpty()) {
                continue;
            }
            
            int idealServer = i % k;
            Integer assignedServer = available.ceiling(idealServer);
            
            
            if (assignedServer == null) {
                assignedServer = available.first();
            }
            
            available.remove(assignedServer);
            busy.offer(new int[]{arrivalTime + currentLoad, assignedServer});
            count[assignedServer]++;
            maxRequests = Math.max(maxRequests, count[assignedServer]);
        }
        
        List<Integer> result = new ArrayList<>();
        for (int i = 0; i < k; i++) {
            if (count[i] == maxRequests) {
                result.add(i);
            }
        }
        
        return result;
    }
}
