class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int inc = 1,decl = 1;
        int maxl = 1;
      for(int i = 0;i<nums.length-1;i++){
        if(nums[i+1]>nums[i]){
            inc++;
            decl = 1;
        }else if(nums[i+1]<nums[i]){
            decl++;
            inc = 1;
        }else{
            inc = 1;
            decl =1;
        }
        maxl = Math.max(maxl,Math.max(inc,decl));
      }
      return maxl;
    }
}
